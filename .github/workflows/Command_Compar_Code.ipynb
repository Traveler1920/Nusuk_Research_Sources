import pandas as pd
import numpy as np

def compute_wer_alignment(reference: str, hypothesis: str, line_number: int):
    """
    Computes Levenshtein distance at the word level and outputs
    alignment pairs for a specific line sequence.
    """
    ref_words = reference.split()
    hyp_words = hypothesis.split()

    n_ref = len(ref_words)
    n_hyp = len(hyp_words)

    dp = np.zeros((n_ref + 1, n_hyp + 1), dtype=int)

    for i in range(n_ref + 1):
        dp[i] = i
    for j in range(n_hyp + 1):
        dp[j] = j

    for i in range(1, n_ref + 1):
        for j in range(1, n_hyp + 1):
            if ref_words[i - 1] == hyp_words[j - 1]:
                dp[i][j] = dp[i - 1][j - 1]
            else:
                dp[i][j] = min(dp[i - 1][j - 1] + 1, dp[i - 1][j] + 1, dp[i][j - 1] + 1)

    i, j = n_ref, n_hyp
    alignment_path = []

    while i > 0 or j > 0:
        if i > 0 and j > 0 and ref_words[i - 1] == hyp_words[j - 1]:
            alignment_path.append((ref_words[i - 1], hyp_words[j - 1], "Match"))
            i -= 1
            j -= 1
        else:
            sub_cost = dp[i - 1][j - 1] if (i > 0 and j > 0) else float('inf')
            del_cost = dp[i - 1][j] if i > 0 else float('inf')
            ins_cost = dp[i][j - 1] if j > 0 else float('inf')

            current_min = min(sub_cost, del_cost, ins_cost)

            if current_min == sub_cost:
                alignment_path.append((ref_words[i - 1], hyp_words[j - 1], "Substitution (S)"))
                i -= 1
                j -= 1
            elif current_min == del_cost:
                alignment_path.append((ref_words[i - 1], "*(omitted)*", "Deletion (D)"))
                i -= 1
            else:
                alignment_path.append(("*(none)*", hyp_words[j - 1], "Insertion (I)"))
                j -= 1

    alignment_path.reverse()

    line_data = []
    for idx, (ref, hyp, error_type) in enumerate(alignment_path, start=1):
        penalty = 0 if error_type == "Match" else 1
        note = "Correct"
        if "Substitution" in error_type: note = "Contextual swap"
        elif "Deletion" in error_type: note = "Conservative Drop"
        elif "Insertion" in error_type: note = "Hallucination/Filler"

        line_data.append({
            "Line #": line_number,
            "Word Position": idx,
            "Reference Word": ref,
            "AI Hypothesis": hyp,
            "Error Type": error_type,
            "Penalty": penalty,
            "Behavior Note": note
        })

    return line_data, n_ref, error_type

def run_interactive_evaluator():
    all_word_rows = []
    total_ref_words = 0
    total_substitutions = 0
    total_deletions = 0
    total_insertions = 0

    line_counter = 1

    print("==================================================")
    print("   CONSERVATIVE AI PER-WORD ERROR EVALUATOR   ")
    print("==================================================\n")

    while True:
        print(f"--- Line #{line_counter} ---")
        ref_input = input("Enter Original Text (Ground Truth): ").strip()
        ai_input = input("Enter AI Interpretation: ").strip()

        
        line_rows, ref_word_count, _ = compute_wer_alignment(ref_input, ai_input, line_counter)
        all_word_rows.extend(line_rows)
        total_ref_words += ref_word_count

        
        for row in line_rows:
            if "Substitution" in row["Error Type"]: total_substitutions += 1
            elif "Deletion" in row["Error Type"]: total_deletions += 1
            elif "Insertion" in row["Error Type"]: total_insertions += 1

        print("\nLine added successfully.")

        
        choice = input("Type 'continue' to add another line, or 'done' to see final tables: ").strip().lower()
        print("-" * 50)

        if choice == 'done':
            break
        elif choice == 'continue':
            line_counter += 1
        else:
            print("Invalid input detected, but keeping data. Moving to next line by default...")
            line_counter += 1

    
    master_df = pd.DataFrame(all_word_rows)
    total_errors = total_substitutions + total_deletions + total_insertions
    overall_wer = (total_errors / total_ref_words * 100) if total_ref_words > 0 else 0

    print("\n==================================================")
    print("            FINAL MASTER ACCURACY REPORT          ")
    print("==================================================")
    print(f"Total Lines Evaluated:    {line_counter}")
    print(f"Total Reference Words:    {total_ref_words}")
    print(f"Total Substitutions (S):  {total_substitutions}")
    print(f"Total Deletions (D):      {total_deletions} <-- (Conservative drop signal)")
    print(f"Total Insertions (I):     {total_insertions}")
    print(f"Global Word Error Rate:   {overall_wer:.2f}%")
    print("==================================================\n")

    print("--- COMPLETE PER-WORD ALIGNMENT TABLE ---")
    pd.set_option('display.max_rows', None) 
    print(master_df.to_string(index=False))

   
    save_choice = input("\nWould you like to save this complete table to an Excel file? (yes/no): ").strip().lower()
    if save_choice in ['yes', 'y']:
        filename = "master_ai_error_report.xlsx"
        master_df.to_excel(filename, index=False)
        print(f"Success! Data saved to '{filename}'.")

if __name__ == "__main__":
    run_interactive_evaluator()
